PORT=4000

# Optional: set one of these to use a real LLM for bill reading, message
# writing and Q&A instead of the offline mock provider. Leave both unset to
# run fully offline. If both are set, Gemini is used unless LLM_PROVIDER
# forces a choice ("gemini" | "anthropic" | "mock").

# Google Gemini (free tier) -- get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Opt-in: use AWS's Strands Agents SDK (TypeScript preview) for ask-anytime
# Q&A instead of the direct Gemini call. Requires GEMINI_API_KEY. Falls back
# to the direct call automatically on any error -- the SDK is preview/
# experimental, so this is never the default.
# STRANDS_QA=true

# Anthropic (no free tier)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# LLM_PROVIDER=gemini

# Real WhatsApp channel via Twilio's free Sandbox -- get these at
# https://console.twilio.com (no credit card needed). Console -> Messaging
# -> Try it out -> Send a WhatsApp message gives you TWILIO_WHATSAPP_FROM
# and the "join <code>" text to send from your own phone to activate it.
# Without these set, the /whatsapp/webhook route still replies to text
# messages -- it just can't read bill photos or send the 6pm proactive push.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
